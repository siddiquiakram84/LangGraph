# LangSmith observability — get your key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=langgraph-healing-engine

# Anthropic Claude — set this to use Claude for intent extraction (auto-gen)
# If not set, falls back to Ollama automatically
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama local LLM (fallback — no key needed, needs Ollama running locally)
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_BASE_URL=http://localhost:11434
