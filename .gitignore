# ══════════════════════════════════════════════════════════════════════════════
# LangGraph AI Test Automation — .gitignore
# ══════════════════════════════════════════════════════════════════════════════


# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.envrc
.env.*
!.env.example


# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd


# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
automation-project/venv/
**/.venv/


# ── Python packaging / build ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
.installed.cfg
__pypackages__/
.pdm-python
.pdm-build/
.pixi/
wheels/
sdist/
develop-eggs/
.eggs/


# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
*.cover


# ── Allure reports (generated by CI — not committed) ─────────────────────────
report/allure/results/
report/allure/html/
allure-results/
allure-report/


# ── Playwright artifacts ──────────────────────────────────────────────────────
report/playwright/screenshots/
report/playwright/videos/
report/playwright/pdf/
*.mp4
*.webm


# ── AI pipeline runtime reports ───────────────────────────────────────────────
# Timestamped per-run files — regenerated each pipeline run
report/analytics/pipeline_report_*.json
report/healing/


# ── AI memory / vector store runtime state ────────────────────────────────────
# FAISS binary index + pickle — large, machine-specific, regenerated at runtime
ai/memory/
healing_memory/


# ── Auto-generated code (pipeline output — regenerated on demand) ─────────────
automation-project/pages/generated/
automation-project/locators/generated/
automation-project/tests/ui/generated/


# ── FileWriter backup files ───────────────────────────────────────────────────
*.bak_*.py


# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt


# ── OS & editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~


# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb


# ── Type checkers / linters ───────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# ── Docs ──────────────────────────────────────────────────────────────────────
docs/_build/
site/


# ── Misc Python tools ─────────────────────────────────────────────────────────
.spyderproject
.spyproject
.ropeproject
cython_debug/
.abstra/
.pypirc
